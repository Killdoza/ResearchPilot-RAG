# Required by the frozen legacy baseline. Replace with your own key locally.
DEEPSEEK_API_KEY=replace_with_your_deepseek_api_key

# Optional non-secret overrides. Relative paths are resolved from the repository root.
# New stores default to data/runtime/ and keep frozen legacy data untouched.
# RESEARCHPILOT_GLOBAL_CHROMA_DIR=data/runtime/chroma_global
# RESEARCHPILOT_SESSION_CHROMA_DIR=data/runtime/chroma_session
# 若项目路径含中文等非 ASCII 字符，Windows 上的 Chroma 大型 HNSW 索引需要改用 ASCII 路径。
# 示例：RESEARCHPILOT_EVALUATION_CHROMA_DIR=E:/python_projects/ResearchPilot_RAG/data/runtime/chroma_evaluation
# RESEARCHPILOT_EVALUATION_CHROMA_DIR=data/runtime/chroma_evaluation
# RESEARCHPILOT_SPARSE_INDEX_DIR=data/runtime/bm25
# Windows 下请将整个项目放在 ASCII 路径（例如 E:/python_projects/ResearchPilot_RAG）；
# 这样默认的 data/runtime/ Chroma 路径安全，无需额外迁移到项目外目录。
# RESEARCHPILOT_SESSIONS_DIR=data/runtime/sessions
# RESEARCHPILOT_MEMORY_DB_PATH=data/runtime/researchpilot.sqlite3
# RESEARCHPILOT_UPLOADS_DIR=data/runtime/uploads
# RESEARCHPILOT_TRACES_DIR=data/runtime/traces
# RESEARCHPILOT_GLOBAL_COLLECTION=global_memory
# RESEARCHPILOT_SESSION_COLLECTION=session_memory
# RESEARCHPILOT_EVALUATION_COLLECTION=evaluation_papers_v01
# Optional stable local owner ID. Set this before explicitly migrating legacy data.
# RESEARCHPILOT_LOCAL_USER_ID=local_researcher
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# Optional pricing snapshot for local cost estimates. Fill these from the
# provider's current price page; leaving them empty records cost as unknown.
# DEEPSEEK_INPUT_COST_PER_MILLION=
# DEEPSEEK_OUTPUT_COST_PER_MILLION=
# Strict cross-document mode is disabled by default. Enable only after deploying
# a compatible scoped document catalog; it is not the default single-paper path.
# RESEARCHPILOT_API_STRICT_CROSSDOC_ENABLED=false
